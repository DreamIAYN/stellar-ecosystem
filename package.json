{
  "name": "stellar-ecosystem",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "concurrently -n WEB,EDGE -c cyan,magenta \"pnpm --filter @stellar/web dev\" \"pnpm --filter @stellar/server dev\"",
    "dev:web": "pnpm --filter @stellar/web dev",
    "dev:server": "pnpm --filter @stellar/server dev",
    "build": "pnpm --filter @stellar/web build && pnpm --filter @stellar/server build",
    "start": "pnpm --filter @stellar/server start",
    "typecheck": "pnpm -r typecheck",
    "preview": "pnpm --filter @stellar/web preview"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "description": "星环 Stellar — 开源、本地优先、可自托管的个人数字生态，12 个可互相调用的应用。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DreamIAYN/stellar-ecosystem.git"
  },
  "homepage": "https://github.com/DreamIAYN/stellar-ecosystem#readme",
  "bugs": {
    "url": "https://github.com/DreamIAYN/stellar-ecosystem/issues"
  },
  "author": "DreamIAYN",
  "keywords": [
    "local-first",
    "pwa",
    "react",
    "typescript",
    "webrtc",
    "ocr",
    "scanner",
    "notes",
    "ecosystem",
    "self-hosted"
  ]
}
